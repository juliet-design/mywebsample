
@page
@model RentalHouseWebsite.Pages.AboutModel

@{
    ViewData["Title"] = "About Us";
}

<style>

    .about-page {
        background: #f5f5f5;
    }

    /* =========================
       ABOUT HERO
       ========================= */

    .about-page .about-hero {
        background:
            linear-gradient(
                rgba(0, 0, 0, 0.65),
                rgba(0, 0, 0, 0.65)
            ),
            url('/images/house.jpg') center/cover no-repeat;

        min-height: 330px;

        display: flex;
        align-items: center;
        justify-content: center;

        text-align: center;

        color: white;
        padding: 60px 20px;
    }

    .about-page .about-hero-content {
        max-width: 800px;
    }

    .about-page .about-hero h1 {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .about-page .about-hero p {
        font-size: 19px;
        color: #eee;
    }


    /* =========================
       ABOUT SECTION
       ========================= */

    .about-page .about-section {
        padding: 80px 20px;
        background: white;
    }

    .about-page .about-container {
        max-width: 1200px;
        margin: auto;
    }

    .about-page .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }


    /* =========================
       ABOUT IMAGE
       ========================= */

    .about-page .about-image {
        height: 480px;
        overflow: hidden;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
    }

    .about-page .about-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }


    /* =========================
       ABOUT CONTENT
       ========================= */

    .about-page .section-label {
        display: inline-block;

        color: #d99d00;

        font-size: 14px;
        font-weight: bold;

        letter-spacing: 1.5px;

        margin-bottom: 12px;
    }

    .about-page .about-content h2 {
        font-size: 40px;

        color: #222;

        line-height: 1.2;

        margin-bottom: 20px;
    }

    .about-page .about-content > p {
        color: #666;

        font-size: 16px;

        line-height: 1.8;

        margin-bottom: 18px;
    }


    /* =========================
       FEATURES
       ========================= */

    .about-page .about-features {
        margin-top: 30px;
    }

    .about-page .about-feature {
        display: flex;

        align-items: flex-start;

        gap: 15px;

        margin-bottom: 22px;
    }

    .about-page .feature-icon {
        width: 50px;
        height: 50px;

        flex-shrink: 0;

        background: #f5b400;

        border-radius: 50%;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 22px;
    }

    .about-page .about-feature h3 {
        margin: 0 0 5px;

        color: #222;

        font-size: 19px;
    }

    .about-page .about-feature p {
        margin: 0;

        color: #777;

        line-height: 1.6;
    }


    /* =========================
       STATISTICS
       ========================= */

    .about-page .about-stats {
        background: #222;

        padding: 60px 20px;
    }

    .about-page .stats-container {
        max-width: 1200px;

        margin: auto;
    }

    .about-page .stats-grid {
        display: grid;

        grid-template-columns: repeat(4, 1fr);

        gap: 25px;
    }

    .about-page .stat-box {
        text-align: center;

        padding: 25px;

        background: #2d2d2d;

        border-radius: 10px;
    }

    .about-page .stat-box h2 {
        color: #f5b400;

        font-size: 38px;

        margin-bottom: 5px;
    }

    .about-page .stat-box p {
        color: #ddd;

        margin: 0;
    }


    /* =========================
       TABLET
       ========================= */

    @@media (max-width: 900px) {

        .about-page .about-grid {
            grid-template-columns: 1fr;

            gap: 40px;
        }

        .about-page .about-image {
            height: 400px;
        }

        .about-page .about-content h2 {
            font-size: 34px;
        }

        .about-page .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    /* =========================
       MOBILE
       ========================= */

    @@media (max-width: 600px) {

        .about-page .about-hero {
            min-height: 280px;

            padding: 50px 20px;
        }

        .about-page .about-hero h1 {
            font-size: 36px;
        }

        .about-page .about-hero p {
            font-size: 16px;
        }

        .about-page .about-section {
            padding: 50px 20px;
        }

        .about-page .about-image {
            height: 300px;
        }

        .about-page .about-content h2 {
            font-size: 30px;
        }

        .about-page .stats-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


<div class="about-page">


    <!-- =========================
         HERO
         ========================= -->

    <section class="about-hero">

        <div class="about-hero-content">

            <h1>
                About Us
            </h1>

            <p>
                Learn more about Rental House and what we do.
            </p>

        </div>

    </section>


    <!-- =========================
         ABOUT CONTENT
         ========================= -->

    <section class="about-section">

        <div class="about-container">

            <div class="about-grid">


                <!-- IMAGE -->

                <div class="about-image">

                    <img src="~/images/house.jpg"
                         alt="Rental House" />

                </div>


                <!-- TEXT -->

                <div class="about-content">

                    <span class="section-label">
                        ABOUT RENTAL HOUSE
                    </span>


                    <h2>
                        Find A Place You Can Call Home
                    </h2>


                    <p>
                        Rental House is a platform designed to make
                        finding comfortable and affordable rental
                        properties easier.
                    </p>


                    <p>
                        We connect people looking for homes with
                        available rental properties in different
                        locations. Our goal is to make property
                        searching simple, convenient and accessible.
                    </p>


                    <!-- FEATURES -->

                    <div class="about-features">


                        <!-- QUALITY HOMES -->

                        <div class="about-feature">

                            <div class="feature-icon">
                                🏠
                            </div>

                            <div>

                                <h3>
                                    Quality Homes
                                </h3>

                                <p>
                                    Explore different homes that
                                    suit your needs.
                                </p>

                            </div>

                        </div>


                        <!-- EASY SEARCH -->

                        <div class="about-feature">

                            <div class="feature-icon">
                                🔍
                            </div>

                            <div>

                                <h3>
                                    Easy Search
                                </h3>

                                <p>
                                    Find properties using location
                                    and bedroom filters.
                                </p>

                            </div>

                        </div>


                        <!-- TRUSTED SERVICE -->

                        <div class="about-feature">

                            <div class="feature-icon">
                                🤝
                            </div>

                            <div>

                                <h3>
                                    Trusted Service
                                </h3>

                                <p>
                                    We aim to provide a simple and
                                    reliable rental experience.
                                </p>

                            </div>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         STATISTICS
         ========================= -->

    <section class="about-stats">

        <div class="stats-container">

            <div class="stats-grid">


                <!-- STAT 1 -->

                <div class="stat-box">

                    <h2>
                        100+
                    </h2>

                    <p>
                        Available Homes
                    </p>

                </div>


                <!-- STAT 2 -->

                <div class="stat-box">

                    <h2>
                        50+
                    </h2>

                    <p>
                        Happy Clients
                    </p>

                </div>


                <!-- STAT 3 -->

                <div class="stat-box">

                    <h2>
                        20+
                    </h2>

                    <p>
                        Locations
                    </p>

                </div>


                <!-- STAT 4 -->

                <div class="stat-box">

                    <h2>
                        24/7
                    </h2>

                    <p>
                        Support
                    </p>

                </div>


            </div>

        </div>

    </section>


</div>

