@page
@model RentalHouseWebsite.Pages.BookingModel

@{
    ViewData["Title"] = "Book Property";
}

<div class="booking-page">

    <div class="booking-container">

        <h1>Book Property</h1>

        @if (TempData["BookingSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["BookingSuccess"]
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">
                @Model.ErrorMessage
            </div>
        }

        @if (Model.Property != null)
        {
            <div class="property-summary">

                <h2>@Model.Property.Title</h2>

                <p>
                    <strong>Location:</strong>
                    @Model.Property.Location
                </p>

                <p>
                    <strong>Rent:</strong>
                    KSh @Model.Property.Price.ToString("N0")
                </p>

            </div>

            <form method="post">

                <input type="hidden"
                       asp-for="PropertyId" />

                <div class="form-group">

                    <label asp-for="BookingDate">
                        Preferred Booking Date
                    </label>

                    <input asp-for="BookingDate"
                           type="date"
                           class="form-control"
                           required />

                </div>

                <div class="form-group">

                    <label asp-for="Message">
                        Message
                    </label>

                    <textarea asp-for="Message"
                              class="form-control"
                              rows="5"
                              placeholder="Write a message about your booking..."></textarea>

                </div>

                <button type="submit"
                        class="btn-book">
                    Confirm Booking
                </button>

            </form>
        }
        else
        {
            <div class="alert alert-danger">
                Property not found.
            </div>
        }

    </div>

</div>

<style>

.booking-page {
    padding: 60px 20px;
    background: #f5f5f5;
    min-height: 80vh;
}

.booking-container {
    max-width: 700px;
    margin: auto;
    background: white;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.booking-container h1 {
    margin-bottom: 30px;
}

.property-summary {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 30px;
}

.property-summary h2 {
    margin-top: 0;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
}

.form-control {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    box-sizing: border-box;
}

.btn-book {
    background: #f5b400;
    color: #000;
    border: none;
    padding: 14px 25px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
}

.btn-book:hover {
    background: #d99e00;
}

.alert {
    padding: 15px;
    border-radius: 6px;
    margin-bottom: 20px;
}

.alert-success {
    background: #d4edda;
    color: #155724;
}

.alert-danger {
    background: #f8d7da;
    color: #721c24;
}

</style>