@page
@model RentalHouseWebsite.Pages.AdminProfileModel

@{
    Layout = null;
    ViewData["Title"] = "Admin Profile";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Admin Profile</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
        }

        .header {
            background: #111;
            color: white;
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
        }

        .header h1 {
            color: #f5b400;
        }

        .header a {
            color: white;
            text-decoration: none;
            margin-left: 20px;
        }

        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 20px;
        }

        .profile {
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
        }

        .avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #f5b400;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 45px;
            margin: 0 auto 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        .row {
            padding: 15px;
            border-bottom: 1px solid #eee;
        }

        .label {
            color: #777;
            font-size: 13px;
        }

        .value {
            font-size: 18px;
            margin-top: 5px;
        }

        .back {
            display: inline-block;
            margin-top: 25px;
            background: #111;
            color: white;
            text-decoration: none;
            padding: 12px 20px;
            border-radius: 6px;
        }

        .back:hover {
            background: #f5b400;
            color: #111;
        }

    </style>

</head>

<body>

    <div class="header">

        <h1>Rental House</h1>

        <div>
            <a href="/AdminDashboard">Dashboard</a>
            <a href="/AdminSettings">Settings</a>
        </div>

    </div>

    <div class="container">

        <div class="profile">

            <div class="avatar">
                👤
            </div>

            <h2>Administrator Profile</h2>

            <div class="row">

                <div class="label">
                    Name
                </div>

                <div class="value">
                    @Model.AdminName
                </div>

            </div>

            <div class="row">

                <div class="label">
                    Email
                </div>

                <div class="value">
                    @Model.AdminEmail
                </div>

            </div>

            <div class="row">

                <div class="label">
                    Account Type
                </div>

                <div class="value">
                    Administrator
                </div>

            </div>

            <a href="/AdminDashboard"
               class="back">
                ← Back to Dashboard
            </a>

        </div>

    </div>

</body>

</html>